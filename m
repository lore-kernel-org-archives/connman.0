+	ret = dhcp_check_option(DHCP_MAX_SIZE, 2);
+	g_assert(ret);
+	ret = dhcp_check_option(DHCP_MAX_SIZE, 1);
+	g_assert(!ret);
+	ret = dhcp_check_option(DHCP_MESSAGE_TYPE, 1);
